# Copy this file to ".env" (same folder) and fill in the values. ".env" is never shared or committed.
# Azure portal -> your Search service (boulon-pilot-search) -> Settings -> Keys
# Prefer the QUERY key (read-only). Use the admin key only if you want Claude to list indexes / read index settings.
AZURE_SEARCH_ENDPOINT=https://boulon-pilot-search.search.windows.net
AZURE_SEARCH_KEY=paste-key-here
AZURE_SEARCH_INDEX=boulon-pilot-index
