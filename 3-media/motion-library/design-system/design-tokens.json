    "principles": [
      "Glide, do not snap.",
      "Settle, do not bounce.",
      "Breathe, do not drift.",
      "Layer, do not scatter: one leading movement and at most one supporting movement.",
      "Travel less: usually 4 to 16 px.",
      "Preserve reading: body copy and prices do not move while being read.",
      "Respond quietly: hover and press feedback is prompt but low in amplitude.",
      "Rest between moments."
    ],
    "reject": [
      "Elastic, rubbery or repeated bounce",
      "Large overshoot",
      "Fast alternating directions",
      "Surprise rotation",
      "Continuous parallax behind readable content",
      "Blur-heavy entrances that stay soft too long",
      "Long stagger chains",
      "Simultaneous motion across unrelated sections",
      "Autoplay that cannot be stopped at the specimen level"
    ]
